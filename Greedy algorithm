public class Greedy {
public static void GreedyChange(int amount) {
        int[] denominations = {1, 5, 10, 50, 100, 500};
        //to count number of banknotes used for per denomination
        int [] count = new int [denominations.length];
        // initalize count array by zeros refering to there is no banknote has been taken yet 
        for (int j=0; j<count.length; j++){
            count[j]=0;
        }
        // to count minimum total number of used banknotes
        int total=0;
        // initially we will start from largest denominations to applies greedy approach
        for (int i=denominations.length-1; i>= 0; i--) {
            // take as large as possible number of each denomination
            count[i]= amount/denominations[i];
            total += count[i];
            // update remaining amount
            amount = amount%denominations[i];
        }
        // printing the solution
        System.out.println("number of banknotes : " + total);
        for(int k=count.length-1; k>=0 ; k--){
            System.out.println(denominations[k]+" --> "+count[k]);
        }
    }
    }


package com.mycompany.atm;
public class ATM {
    
    public static void dpMinimumBanknotes(int amount){

        int bankNotes []= {1, 5, 10, 50, 100, 500};
        int savedS [][]=new int[bankNotes.length+1][amount+1];
        
        // initialize row 0 by infinity to express that is impossible to form i amount by 0 banknotes 
        for (int i = 0; i<=amount;i++){ 
            savedS [0][i] = Integer.MAX_VALUE; 
        }
        
        // initialize colum 0 by 0 to express that we need 0 banknote to form 0 amount 
        for (int j = 0; j<=bankNotes.length; j++){ 
            savedS [j][0] = 0;
        }
        
        // fill table by minimum number of banknotes requierd to form amount i (compute value of optimal solution)
        for (int i=1; i<=bankNotes.length;i++){
            for (int j=1; j<=amount; j++){
                if (bankNotes[i-1] <= j)
                    savedS[i][j] = Math.min(savedS[i-1][j], savedS[i][j - bankNotes[i-1]]+1);
                else
                    savedS[i][j] = savedS[i-1][j];
            }
        }
        
        System.out.println("Minimum number of banknotes:" + savedS[bankNotes.length][amount]);
        
        // construct optimal solution 
        System.out.print("Banknotes: ");
        int i= bankNotes.length, j=amount;
        while(i>0 && j>0){
            if(savedS[i][j]==savedS[i-1][j])
                i--;
            else{
                System.out.print(bankNotes[i-1]+" ");
                j= j-bankNotes[i-1];
            }
        }
    }

    public static void main(String[] args) {
        double t1 = System.nanoTime();
        dpMinimumBanknotes(15000);
        double t2 = System.nanoTime();
        System.out.println("\n"+(t2-t1));
           
    }
}

